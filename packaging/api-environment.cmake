if("$ENV{MELODESK_API_ID}" STREQUAL "" OR "$ENV{MELODESK_API_HASH}" STREQUAL "")
  message(FATAL_ERROR "Set MELODESK_API_ID and MELODESK_API_HASH in the environment")
endif()
set(TDESKTOP_API_ID "$ENV{MELODESK_API_ID}" CACHE STRING "" FORCE)
set(TDESKTOP_API_HASH "$ENV{MELODESK_API_HASH}" CACHE STRING "" FORCE)
set(DESKTOP_APP_DISABLE_AUTOUPDATE ON CACHE BOOL "" FORCE)
set(CMAKE_CXX_FLAGS_DEBUG "/Zi /O2 /Ob2" CACHE STRING "" FORCE)
set(CMAKE_C_FLAGS_DEBUG "/Zi /O2 /Ob2" CACHE STRING "" FORCE)
set(CMAKE_EXE_LINKER_FLAGS_DEBUG "/DEBUG /OPT:REF /OPT:ICF" CACHE STRING "" FORCE)
