<Window x:Class="MeloDesk.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:ui="clr-namespace:MeloDesk.UI"
 xmlns:sys="clr-namespace:System;assembly=System.Runtime"
 Title="MeloDesk" Width="1320" Height="850" MinWidth="1000" MinHeight="650"
 Background="#0E1621" Foreground="#E7EDF3" FontFamily="Segoe UI" WindowStartupLocation="CenterScreen">
 <Window.Resources>
  <sys:Double x:Key="{x:Static SystemParameters.VerticalScrollBarWidthKey}">7</sys:Double>
  <sys:Double x:Key="{x:Static SystemParameters.HorizontalScrollBarHeightKey}">7</sys:Double>
  <BooleanToVisibilityConverter x:Key="BoolVisibility"/>
  <Style TargetType="ComboBox">
   <Setter Property="Foreground" Value="#E7EDF3"/><Setter Property="Background" Value="#243547"/><Setter Property="Padding" Value="10,8"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBox">
    <Grid><ToggleButton x:Name="Toggle" IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}" Focusable="False" Background="{TemplateBinding Background}" BorderThickness="0"><ToggleButton.Template><ControlTemplate TargetType="ToggleButton"><Border Background="{TemplateBinding Background}" CornerRadius="6"/></ControlTemplate></ToggleButton.Template></ToggleButton>
     <ContentPresenter Margin="10,8,25,8" Content="{TemplateBinding SelectionBoxItem}" IsHitTestVisible="False"/>
     <TextBlock Text="⌄" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,10,0" IsHitTestVisible="False"/>
     <Popup x:Name="PART_Popup" Placement="Bottom" IsOpen="{TemplateBinding IsDropDownOpen}" AllowsTransparency="True" Focusable="False" PopupAnimation="Fade"><Border Background="#243547" BorderBrush="#3A5063" BorderThickness="1" MinWidth="220"><ScrollViewer MaxHeight="300" HorizontalScrollBarVisibility="Disabled"><ItemsPresenter/></ScrollViewer></Border></Popup>
    </Grid>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="ComboBoxItem"><Setter Property="Foreground" Value="#E7EDF3"/><Setter Property="Padding" Value="12,9"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBoxItem"><Border x:Name="ItemBody" Background="#243547" Padding="{TemplateBinding Padding}"><ContentPresenter/></Border><ControlTemplate.Triggers><Trigger Property="IsHighlighted" Value="True"><Setter TargetName="ItemBody" Property="Background" Value="#2B5278"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
  <Style TargetType="ScrollBar">
   <Setter Property="Width" Value="7"/><Setter Property="Background" Value="Transparent"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ScrollBar">
    <Grid Background="Transparent"><Track x:Name="PART_Track" IsDirectionReversed="True" Orientation="Vertical">
     <Track.DecreaseRepeatButton><RepeatButton Command="ScrollBar.PageUpCommand" Opacity="0" Focusable="False"/></Track.DecreaseRepeatButton>
     <Track.Thumb><Thumb><Thumb.Style><Style TargetType="Thumb"><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Thumb"><Border x:Name="ThumbBody" Background="#546574" CornerRadius="3" Margin="1,0"/><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ThumbBody" Property="Background" Value="#8293A1"/></Trigger><Trigger Property="IsDragging" Value="True"><Setter TargetName="ThumbBody" Property="Background" Value="#9CAAB5"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style></Thumb.Style></Thumb></Track.Thumb>
     <Track.IncreaseRepeatButton><RepeatButton Command="ScrollBar.PageDownCommand" Opacity="0" Focusable="False"/></Track.IncreaseRepeatButton>
    </Track></Grid>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="Button">
   <Setter Property="Background" Value="#243547"/><Setter Property="Foreground" Value="#DCE7F1"/>
   <Setter Property="BorderThickness" Value="0"/><Setter Property="Padding" Value="16,10"/><Setter Property="Cursor" Value="Hand"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
    <Border x:Name="B" Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center"/></Border>
    <ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="B" Property="Opacity" Value="0.8"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="B" Property="Opacity" Value="0.45"/></Trigger></ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="Rail" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
   <Setter Property="Background" Value="Transparent"/><Setter Property="Foreground" Value="#7E96AA"/><Setter Property="Padding" Value="2,11"/><Setter Property="Margin" Value="5,3"/><Setter Property="HorizontalContentAlignment" Value="Center"/>
  </Style>
  <Style x:Key="Chip" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
   <Setter Property="Padding" Value="17,8"/><Setter Property="Margin" Value="0,0,8,0"/><Setter Property="Background" Value="#223041"/>
  </Style>
  <Style TargetType="TextBox">
   <Setter Property="Background" Value="#242F3D"/><Setter Property="Foreground" Value="#E7EDF3"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Padding" Value="12,10"/><Setter Property="CaretBrush" Value="#66B5EC"/>
  </Style>
 </Window.Resources>
 <Grid>
  <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <Grid>
   <Grid.ColumnDefinitions><ColumnDefinition Width="64"/><ColumnDefinition Width="380" MinWidth="280" MaxWidth="650"/><ColumnDefinition Width="*" MinWidth="460"/></Grid.ColumnDefinitions>
   <Border Background="#0E1621" BorderBrush="#0B111A" BorderThickness="0,0,1,0">
    <DockPanel>
     <TextBlock DockPanel.Dock="Top" Text="☰" Foreground="#8AA3B8" FontSize="22" HorizontalAlignment="Center" Margin="0,21,0,19"/>
     <StackPanel DockPanel.Dock="Top">
      <Button x:Name="AllChatsButton" Click="AllChats_Click" Style="{StaticResource Rail}" Background="#20384C" Foreground="#65B9F4">
       <StackPanel><TextBlock Text="&#xE8F2;" FontFamily="Segoe MDL2 Assets" FontSize="25" HorizontalAlignment="Center"/><TextBlock Text="Все чаты" FontSize="10" Margin="0,4,0,0"/></StackPanel>
      </Button>
      <Button x:Name="PersonalButton" Click="Personal_Click" Style="{StaticResource Rail}">
       <StackPanel><TextBlock Text="&#xE77B;" FontFamily="Segoe MDL2 Assets" FontSize="23" HorizontalAlignment="Center"/><TextBlock Text="Личные" FontSize="10" Margin="0,4,0,0"/></StackPanel>
      </Button>
      <Button x:Name="MusicButton" Click="Music_Click" Style="{StaticResource Rail}">
       <StackPanel><TextBlock Text="♫" FontSize="26" HorizontalAlignment="Center"/><TextBlock Text="Музыка" FontSize="10" Margin="0,4,0,0"/></StackPanel>
      </Button>
     </StackPanel>
    </DockPanel>
   </Border>
   <Grid x:Name="ChatListPane" Grid.Column="1" Background="#17212B">
    <Grid.RowDefinitions><RowDefinition Height="56"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <Border Background="#242F3D" CornerRadius="20" Margin="12,8,12,8">
     <Grid><TextBox x:Name="ChatSearch" TextChanged="ChatSearch_TextChanged" Background="Transparent" Padding="15,7"/>
      <TextBlock x:Name="ChatSearchHint" Text="Поиск чатов" Foreground="#70889B" Margin="15,0" VerticalAlignment="Center" IsHitTestVisible="False"/>
     </Grid>
    </Border>
    <ListBox x:Name="ChatList" Grid.Row="1" Background="Transparent" BorderThickness="0" SelectionChanged="ChatList_SelectionChanged" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Visible" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" VirtualizingPanel.ScrollUnit="Pixel">
     <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem">
      <Setter Property="Padding" Value="0"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Foreground" Value="#E5EDF4"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><Border x:Name="Row" Background="{TemplateBinding Background}"><ContentPresenter/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Row" Property="Background" Value="#202D3A"/></Trigger><Trigger Property="IsSelected" Value="True"><Setter TargetName="Row" Property="Background" Value="#2B5278"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
     </Style></ListBox.ItemContainerStyle>
     <ListBox.ItemTemplate><DataTemplate>
      <Grid Margin="12,0" Height="70"><Grid.ColumnDefinitions><ColumnDefinition Width="56"/><ColumnDefinition Width="*"/><ColumnDefinition Width="42"/></Grid.ColumnDefinitions>
       <Grid Width="46" Height="46" HorizontalAlignment="Left" VerticalAlignment="Center">
        <Ellipse Fill="#527FA2"/><TextBlock Text="{Binding Initial}" FontSize="19" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
        <Ellipse><Ellipse.Fill><ImageBrush ImageSource="{Binding Avatar.Image}" Stretch="UniformToFill"/></Ellipse.Fill></Ellipse>
       </Grid>
       <StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="{Binding Title}" FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/><TextBlock Text="{Binding Preview}" Foreground="#91A9BC" FontSize="12" Margin="0,6,0,0" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" MaxHeight="18"/></StackPanel>
       <StackPanel Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center"><TextBlock Text="{Binding Time}" Foreground="#7893AA" FontSize="10" HorizontalAlignment="Right"/><TextBlock Text="{Binding UnreadText}" Foreground="#8CC5EB" FontSize="12" HorizontalAlignment="Right" Margin="0,9,0,0"/></StackPanel>
      </Grid>
     </DataTemplate></ListBox.ItemTemplate>
    </ListBox>
    <TextBlock x:Name="ChatListStatus" Grid.Row="2" Text="Подключи Telegram, чтобы увидеть чаты" Foreground="#7890A4" FontSize="12" TextWrapping="Wrap" Margin="15,10,15,15"/>
   </Grid>
   <GridSplitter Grid.Column="1" Width="3" HorizontalAlignment="Right" Background="Transparent" ResizeDirection="Columns" ResizeBehavior="CurrentAndNext"/>
   <Grid x:Name="ConversationPane" Grid.Column="2" Background="#0E1621">
    <Grid.RowDefinitions><RowDefinition Height="66"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <Border Background="#17212B" BorderBrush="#0D141D" BorderThickness="0,0,0,1">
     <DockPanel Margin="20,10">
      <Grid x:Name="HeaderAvatarVisual" Width="42" Height="42" Margin="0,0,12,0" DockPanel.Dock="Left" Visibility="Collapsed">
       <Ellipse Fill="#527FA2"/><TextBlock Text="{Binding SelectedItem.Initial, ElementName=ChatList}" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
       <Ellipse><Ellipse.Fill><ImageBrush ImageSource="{Binding SelectedItem.Avatar.Image, ElementName=ChatList}" Stretch="UniformToFill"/></Ellipse.Fill></Ellipse>
      </Grid>
      <StackPanel VerticalAlignment="Center"><TextBlock x:Name="ChatTitle" Text="MeloDesk" FontSize="15" FontWeight="SemiBold"/><TextBlock x:Name="ChatSubtitle" Text="Твои чаты и музыка рядом" Foreground="#7893A8" FontSize="12" Margin="0,4,0,0"/></StackPanel>
     </DockPanel>
    </Border>
    <ListBox x:Name="MessagesList" Grid.Row="1" Background="Transparent" BorderThickness="0" Padding="12,12" Visibility="Collapsed" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Visible" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" VirtualizingPanel.ScrollUnit="Pixel">
     <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem"><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Focusable" Value="False"/><Setter Property="Padding" Value="0"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><ContentPresenter/></ControlTemplate></Setter.Value></Setter></Style></ListBox.ItemContainerStyle>
     <ListBox.ItemTemplate><DataTemplate>
      <StackPanel>
       <Border Background="#1D2B38" CornerRadius="10" HorizontalAlignment="Center" Margin="0,10" Padding="10,3" Visibility="{Binding ShowDate, Converter={StaticResource BoolVisibility}}"><TextBlock Text="{Binding Date}" Foreground="#9CB4C8" FontSize="11"/></Border>
       <DockPanel HorizontalAlignment="{Binding Alignment}" MaxWidth="610" Margin="0,3">
        <Grid x:Name="SenderAvatarVisual" Width="30" Height="30" VerticalAlignment="Bottom" Margin="0,0,8,0" DockPanel.Dock="Left"><Ellipse Fill="{Binding SenderColor}"/><TextBlock Text="{Binding SenderInitial}" Foreground="White" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center"/><Ellipse><Ellipse.Fill><ImageBrush ImageSource="{Binding SenderAvatar.Image}" Stretch="UniformToFill"/></Ellipse.Fill></Ellipse></Grid>
        <Border Background="{Binding BubbleColor}" CornerRadius="10" Padding="10,7">
         <StackPanel>
          <TextBlock Text="{Binding SenderName}" Foreground="{Binding SenderColor}" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,4"/>
          <ui:MessageAttachmentView x:Name="AttachmentView" Attachment="{Binding Attachment}"/>
          <TextBlock x:Name="MessageBody" Text="{Binding Body}" Foreground="#E5EDF5" TextWrapping="Wrap" FontSize="13"/>
          <TextBlock Text="{Binding Time}" Foreground="#93B0C6" FontSize="10" HorizontalAlignment="Right" Margin="18,3,0,0"/>
         </StackPanel>
        </Border>
       </DockPanel>
      </StackPanel>
      <DataTemplate.Triggers><DataTrigger Binding="{Binding IsOutgoing}" Value="True"><Setter TargetName="SenderAvatarVisual" Property="Visibility" Value="Collapsed"/></DataTrigger><DataTrigger Binding="{Binding Attachment}" Value="{x:Null}"><Setter TargetName="AttachmentView" Property="Visibility" Value="Collapsed"/></DataTrigger><DataTrigger Binding="{Binding Body}" Value=""><Setter TargetName="MessageBody" Property="Visibility" Value="Collapsed"/></DataTrigger></DataTemplate.Triggers>
     </DataTemplate></ListBox.ItemTemplate>
    </ListBox>
    <ScrollViewer x:Name="AuthPanel" Grid.Row="1" VerticalScrollBarVisibility="Auto" VerticalContentAlignment="Center">
    <StackPanel HorizontalAlignment="Center" Width="390" Margin="25">
     <Border Width="72" Height="72" Background="#223C52" CornerRadius="36" HorizontalAlignment="Center"><TextBlock Text="➤" FontSize="37" Foreground="#66B9F3" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
     <TextBlock x:Name="AuthTitle" Text="Вход в Telegram" FontSize="26" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,20,0,8"/>
     <TextBlock x:Name="TelegramStatus" Text="Введи номер телефона с кодом страны" Foreground="#8FA6BA" TextWrapping="Wrap" TextAlignment="Center" Margin="0,0,0,20"/>
     <TextBlock x:Name="AuthFieldLabel" Text="Номер телефона" Foreground="#8FA6BA" FontSize="12" Margin="0,0,0,6"/>
     <TextBox x:Name="AuthInput" KeyDown="AuthField_KeyDown" ToolTip="Номер телефона с кодом страны"/>
     <PasswordBox x:Name="AuthPassword" Background="#242F3D" Foreground="White" Padding="12,10" BorderThickness="0" Visibility="Collapsed" KeyDown="AuthField_KeyDown"/>
     <Button x:Name="AuthSubmit" Content="Продолжить" Click="AuthSubmit_Click" Background="#4F9AD0" Margin="0,12,0,0" HorizontalContentAlignment="Center"/>
     <Expander x:Name="DeveloperSetupExpander" Header="Настройка приложения" Foreground="#7EA2BC" FontSize="12" Margin="0,17,0,0" IsExpanded="False">
     <StackPanel x:Name="CredentialFields" Margin="0,10,0,0">
      <TextBlock Text="Однократная настройка MeloDesk. Эти данные относятся к приложению, а не к входу в аккаунт." Foreground="#8FA6BA" TextWrapping="Wrap" Margin="0,0,0,12"/>
      <TextBlock Text="API ID" Foreground="#8FA6BA" FontSize="12" Margin="0,0,0,6"/><TextBox x:Name="ApiIdInput"/>
      <TextBlock Text="API Hash" Foreground="#8FA6BA" FontSize="12" Margin="0,13,0,6"/><PasswordBox x:Name="ApiHashInput" Background="#242F3D" Foreground="White" Padding="12,10" BorderThickness="0"/>
      <Button Content="Сохранить настройку" Click="ConnectTelegram_Click" Background="#4F9AD0" Margin="0,18,0,0" HorizontalContentAlignment="Center"/>
      <Button Content="Получить API ID на my.telegram.org" Click="OpenTelegramApi_Click" Background="Transparent" Foreground="#64B5ED" FontSize="12" Margin="0,6,0,0" HorizontalContentAlignment="Center"/>
     </StackPanel>
     </Expander>
     <TextBlock x:Name="TdlibVersion" Foreground="#587084" FontSize="11" HorizontalAlignment="Center" Margin="0,18,0,0"/>
    </StackPanel>
    </ScrollViewer>
    <TextBlock x:Name="EmptyChatHint" Grid.Row="1" Text="Выбери чат слева" Foreground="#7E97AA" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"/>
    <Border x:Name="ComposerBar" Grid.Row="2" Background="#17212B" Padding="16,10" Visibility="Collapsed">
     <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <TextBox x:Name="MessageInput" Background="Transparent" TextWrapping="Wrap" AcceptsReturn="True" MaxHeight="130" VerticalScrollBarVisibility="Auto" KeyDown="MessageInput_KeyDown" ToolTip="Сообщение"/>
      <Button Grid.Column="1" Content="➤" Click="SendMessage_Click" FontSize="23" Foreground="#65B8F0" Background="Transparent"/>
     </Grid>
    </Border>
   </Grid>
   <Grid x:Name="MusicView" Grid.Column="1" Grid.ColumnSpan="2" Visibility="Collapsed" Background="#101B27">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <StackPanel Margin="40,30,40,0">
     <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <StackPanel><TextBlock Text="Музыка" FontSize="31" FontWeight="SemiBold"/><TextBlock Text="Найди свой трек. Включи и возвращайся к разговору." Foreground="#819CB2" FontSize="13" Margin="0,7,0,0"/></StackPanel>
      <Button Grid.Column="1" Content="+ Мои файлы" Click="Import_Click" VerticalAlignment="Center" Background="#23384A"/>
     </Grid>
     <Border Background="#1C2B3C" CornerRadius="12" Margin="0,25,0,18" Padding="5">
      <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="40"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
       <TextBlock Text="⌕" Foreground="#75BDEB" FontSize="28" HorizontalAlignment="Center" VerticalAlignment="Center"/>
       <Grid Grid.Column="1"><TextBox x:Name="MusicSearchBox" Background="Transparent" FontSize="16" Padding="8,12" TextChanged="MusicSearch_TextChanged" KeyDown="MusicSearch_KeyDown"/><TextBlock x:Name="MusicSearchHint" Text="Название трека, исполнитель или ссылка" Foreground="#708BA2" FontSize="15" Margin="8,0" VerticalAlignment="Center" IsHitTestVisible="False"/></Grid>
       <Button x:Name="SearchButton" Grid.Column="2" Content="Найти" Click="Search_Click" Background="#5EA9E0" Foreground="#0A1C2B" FontWeight="SemiBold" Padding="26,10" Margin="5"/>
      </Grid>
     </Border>
     <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <StackPanel Orientation="Horizontal"><Button x:Name="AllSources" Content="Все" Tag="Все" Click="Source_Click" Style="{StaticResource Chip}" Background="#3F769D"/><Button x:Name="YouTubeSource" Content="YouTube" Tag="YouTube" Click="Source_Click" Style="{StaticResource Chip}"/><Button x:Name="SoundCloudSource" Content="SoundCloud" Tag="SoundCloud" Click="Source_Click" Style="{StaticResource Chip}"/></StackPanel>
      <TextBlock x:Name="ResultCount" Grid.Column="1" Foreground="#7995AC" VerticalAlignment="Center"/>
     </Grid>
     <TextBlock x:Name="MusicStatus" Text="Введи название и нажми Enter" Foreground="#7F9DB4" FontSize="12" Margin="0,15,0,15" TextWrapping="Wrap"/>
     <WrapPanel Margin="0,0,0,10" VerticalAlignment="Center">
      <Button Content="Результаты поиска" Click="ShowSearchResults_Click" Style="{StaticResource Chip}"/>
      <ComboBox x:Name="PlaylistSelector" Width="220" Margin="0,0,8,0" SelectionChanged="Playlist_SelectionChanged" ToolTip="Плейлисты этого Telegram-аккаунта"/>
      <Grid Width="180" Margin="0,0,8,0"><TextBox x:Name="PlaylistName" MaxLength="100" ToolTip="Название нового плейлиста"/><TextBlock Text="Название плейлиста" Foreground="#7893AA" Margin="12,0" VerticalAlignment="Center" IsHitTestVisible="False"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Text.Length, ElementName=PlaylistName}" Value="0"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></Grid>
      <Button Content="+ Плейлист" Click="CreatePlaylist_Click" Style="{StaticResource Chip}"/>
      <Button Content="↻" Click="SyncPlaylists_Click" Style="{StaticResource Chip}" ToolTip="Синхронизировать через Избранное"/>
      <Button Content="Переименовать" Click="RenamePlaylist_Click" Style="{StaticResource Chip}"/>
      <Button Content="Удалить плейлист" Click="DeletePlaylist_Click" Style="{StaticResource Chip}"/>
     </WrapPanel>
     <TextBlock x:Name="PlaylistStatus" Foreground="#7893AA" FontSize="11" Margin="0,0,0,12" Text="Плейлисты появятся после входа в Telegram" TextWrapping="Wrap"/>
    </StackPanel>
    <Grid Grid.Row="1" Margin="40,0,40,24">
     <ListBox x:Name="TrackList" Background="Transparent" BorderThickness="0" Foreground="#E8EFF5" PreviewMouseLeftButtonUp="TrackList_Click" KeyDown="TrackList_KeyDown" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Visible" SelectionChanged="TrackList_SelectionChanged" MouseMove="TrackList_MouseMove">
      <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem"><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Padding" Value="0"/><Setter Property="Margin" Value="0,3"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><Border x:Name="Row" Background="Transparent" CornerRadius="10"><ContentPresenter/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Row" Property="Background" Value="#1E3042"/></Trigger><Trigger Property="IsSelected" Value="True"><Setter TargetName="Row" Property="Background" Value="#24435B"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style></ListBox.ItemContainerStyle>
      <ListBox.ItemTemplate><DataTemplate>
       <Grid Margin="12,10"><Grid.ColumnDefinitions><ColumnDefinition Width="64"/><ColumnDefinition Width="*"/><ColumnDefinition Width="100"/><ColumnDefinition Width="55"/><ColumnDefinition Width="42"/><ColumnDefinition Width="42"/><ColumnDefinition Width="45"/></Grid.ColumnDefinitions>
        <Border Width="48" Height="48" CornerRadius="8" Background="{Binding CoverColor}" HorizontalAlignment="Left" ClipToBounds="True"><Grid><TextBlock Text="{Binding CoverText}" FontSize="22" HorizontalAlignment="Center" VerticalAlignment="Center"/><Image Source="{Binding Artwork}" Stretch="UniformToFill"/></Grid></Border>
        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,20,0"><TextBlock Text="{Binding Title}" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding Artist}" Foreground="#8CA6BA" FontSize="12" Margin="0,5,0,0" TextTrimming="CharacterEllipsis"/></StackPanel>
        <TextBlock Grid.Column="2" Text="{Binding Provider}" Foreground="#85A1B7" FontSize="12" VerticalAlignment="Center"/>
        <TextBlock Grid.Column="3" Text="{Binding DurationText}" Foreground="#85A1B7" FontSize="12" VerticalAlignment="Center"/>
        <Button Grid.Column="4" Content="+" Tag="{Binding}" Click="AddToPlaylist_Click" ToolTip="Добавить в выбранный плейлист" Background="Transparent" Padding="10,7" VerticalAlignment="Center"/>
        <Button Grid.Column="5" Content="−" Tag="{Binding}" Click="RemoveFromPlaylist_Click" ToolTip="Убрать из выбранного плейлиста" Background="Transparent" Padding="10,7" VerticalAlignment="Center"/>
        <Button Grid.Column="6" Content="▶" Tag="{Binding}" Click="PlayTrack_Click" Background="#2A4A63" Foreground="#93D2FF" Padding="10,7" VerticalAlignment="Center"/>
       </Grid>
      </DataTemplate></ListBox.ItemTemplate>
     </ListBox>
     <StackPanel x:Name="MusicEmptyState" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,0,0,60">
      <Border Width="90" Height="90" Background="#1A3043" CornerRadius="25" HorizontalAlignment="Center"><TextBlock Text="♫" Foreground="#64AFE3" FontSize="50" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
      <TextBlock Text="Всё начинается с одного трека" FontSize="22" FontWeight="SemiBold" Margin="0,23,0,8" HorizontalAlignment="Center"/>
      <TextBlock Text="Ищи по названию в YouTube и SoundCloud" Foreground="#7C98B0" FontSize="14" HorizontalAlignment="Center"/>
     </StackPanel>
    </Grid>
   </Grid>
  </Grid>
  <Border x:Name="PlayerBar" Grid.Row="1" Background="#1C2C3C" BorderBrush="#30506A" BorderThickness="0,1,0,0" Height="83" Visibility="Collapsed">
   <Grid Margin="20,9"><Grid.ColumnDefinitions><ColumnDefinition Width="310"/><ColumnDefinition Width="*"/><ColumnDefinition Width="215"/></Grid.ColumnDefinitions>
    <StackPanel Orientation="Horizontal" VerticalAlignment="Center"><Border Width="47" Height="47" CornerRadius="8" Background="#3F6F91" Margin="0,0,12,0" ClipToBounds="True"><Image x:Name="PlayerArtwork" Stretch="UniformToFill"/></Border><StackPanel Width="240" VerticalAlignment="Center"><TextBlock x:Name="NowPlaying" FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/><TextBlock x:Name="NowPlayingArtist" Foreground="#8EA9BF" FontSize="11" Margin="0,5,0,0" TextTrimming="CharacterEllipsis"/></StackPanel></StackPanel>
    <StackPanel Grid.Column="1" Margin="18,0">
     <StackPanel Orientation="Horizontal" HorizontalAlignment="Center"><Button Content="◀" AutomationProperties.Name="Предыдущий трек" Click="Previous_Click" Padding="12,4" Background="Transparent"/><Button x:Name="PlayPauseButton" Content="▶" AutomationProperties.Name="Воспроизведение или пауза" Click="PlayPause_Click" Padding="16,4" Background="#508CB6" Foreground="White"/><Button Content="▶" AutomationProperties.Name="Следующий трек" Click="Next_Click" Padding="12,4" Background="Transparent"/></StackPanel>
     <Grid Margin="0,3,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="42"/><ColumnDefinition Width="*"/><ColumnDefinition Width="42"/></Grid.ColumnDefinitions><TextBlock x:Name="ElapsedTime" Text="0:00" Foreground="#8EA9BF" FontSize="10" VerticalAlignment="Center"/><Slider x:Name="SeekSlider" Grid.Column="1" Minimum="0" Maximum="1" PreviewMouseLeftButtonDown="Seek_Down" PreviewMouseLeftButtonUp="Seek_Up" KeyUp="Seek_KeyUp"/><TextBlock x:Name="TotalTime" Grid.Column="2" Text="0:00" Foreground="#8EA9BF" FontSize="10" HorizontalAlignment="Right" VerticalAlignment="Center"/></Grid>
    </StackPanel>
    <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right"><TextBlock x:Name="PlaybackStatus" Text="Подключение…" Foreground="#8EA9BF" FontSize="11" HorizontalAlignment="Right" Margin="0,0,0,6"/><StackPanel Orientation="Horizontal"><TextBlock Text="♪" Foreground="#88A8C0" VerticalAlignment="Center" Margin="0,0,10,0"/><Slider x:Name="VolumeSlider" Width="115" Minimum="0" Maximum="100" Value="70" ValueChanged="Volume_Changed"/></StackPanel></StackPanel>
   </Grid>
  </Border>
 </Grid>
</Window>
