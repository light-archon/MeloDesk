<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType><TargetFramework>net8.0-windows</TargetFramework><UseWPF>true</UseWPF>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier><PlatformTarget>x64</PlatformTarget><Version>0.20.0</Version>
    <Title>MeloDesk</Title><Product>MeloDesk</Product><Description>MeloDesk music player</Description>
    <AssemblyTitle>MeloDesk</AssemblyTitle>
    <ApplicationIcon>..\Assets\MeloDesk.ico</ApplicationIcon>
    <Nullable>enable</Nullable><ImplicitUsings>enable</ImplicitUsings>
    <VlcWindowsX64Enabled>true</VlcWindowsX64Enabled><VlcWindowsX86Enabled>false</VlcWindowsX86Enabled><VlcWindowsArm64Enabled>false</VlcWindowsArm64Enabled>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="TagLibSharp" Version="2.3.0"/>
    <PackageReference Include="LibVLCSharp" Version="3.10.2"/><PackageReference Include="VideoLAN.LibVLC.Windows" Version="3.0.24"/>
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="8.0.0"/>
    <Compile Include="..\Music\**\*.cs" Link="Music\%(RecursiveDir)%(Filename)%(Extension)"/>
    <Compile Include="..\AppPaths.cs" Link="AppPaths.cs"/>
    <Content Include="..\tools\**\*" Link="tools\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest"/>
  </ItemGroup>
</Project>
